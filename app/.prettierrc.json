{
  "plugins": ["prettier-plugin-blade", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.blade.php",
      "options": {
        "parser": "blade"
      }
    }
  ],
  "tailwindAttributes": ["class", "className", "ngClass"],
  "tailwindFunctions": ["clsx", "cn", "twMerge", "trans"]
}
